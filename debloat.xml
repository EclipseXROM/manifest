<?xml version="1.0" encoding="UTF-8"?>
<manifest>
    <!-- ================================================================ -->
    <!-- EclipseX debloat layer                                             -->
    <!--                                                                    -->
    <!-- Removes Google-branded surfaces, duplicated stock apps, dev/demo   -->
    <!-- leftovers, non-phone form factors and the multi-GB sync heaps      -->
    <!-- (kernel images, emulator/VM stacks, CTS/VTS test infra, VNDK      -->
    <!-- snapshots, SDK/NDK prebuilts) from the synced tree.                -->
    <!--                                                                    -->
    <!-- Compatibility contract: everything that exposes an API surface     -->
    <!-- other apps rely on STAYS - WebView, DocumentsUI (SAF), KeyChain,   -->
    <!-- providers, telephony, SecureElement, and every                     -->
    <!-- packages/modules/* runtime module. We remove apps, telemetry and   -->
    <!-- dead weight, never the platform.                                   -->
    <!--                                                                    -->
    <!-- The product-level strip lives in vendor/eclipsex/common            -->
    <!-- (config/debloat.mk); the on-device runtime strip tool is           -->
    <!-- debloat/debloat.sh there as well.                                  -->
    <!-- ================================================================ -->


    <!-- ==== Google ads / telemetry ======================================= -->
    <!-- Privacy Sandbox / ads infrastructure.                              -->
    <!-- KEPT (source): packages/modules/AdServices - services.jar          -->
    <!-- (services.core.unboosted) hard-depends on service-sdksandbox       -->
    <!-- stubs and sdk_sandbox aconfig flags; upstream wires it             -->
    <!-- unconditionally, no RELEASE_* flag escape. The SOURCE syncs but    -->
    <!-- the com.android.adservices APEX is filtered out of                 -->
    <!-- PRODUCT_PACKAGES by config/debloat.mk - source present, payload    -->
    <!-- never ships.                                                       -->
    <!-- KEPT (source): OnDevicePersonalization - adservices-service-core   -->
    <!-- links its framework-* stubs. Same deal: source syncs, the          -->
    <!-- com.android.ondevicepersonalization APEX is filtered out.          -->
    <remove-project name="platform/prebuilts/module_sdk/AdServices" />
    <remove-project name="platform/prebuilts/module_sdk/OnDevicePersonalization" />

    <!-- ==== Google search surface ======================================== -->
    <remove-project name="platform/packages/apps/QuickSearchBox" />

    <!-- ==== Stock apps replaced by the EclipseX/Manikineko suite ========= -->
    <remove-project name="platform/packages/apps/Browser2" />
    <remove-project name="platform/packages/apps/Calendar" />
    <remove-project name="platform/packages/apps/Gallery" />
    <remove-project name="platform/packages/apps/Gallery2" />
    <remove-project name="platform/packages/apps/Music" />
    <remove-project name="platform/packages/apps/MusicFX" />
    <remove-project name="platform/packages/apps/HTMLViewer" />
    <remove-project name="platform/packages/apps/LegacyCamera" />
    <remove-project name="platform/packages/apps/AvatarPicker" />

    <!-- ==== Stock launcher + theming (replaced by EclipseXHome) ========== -->
    <!-- KEPT (source): packages/apps/Launcher3 - services.core and         -->
    <!-- iconloaderlib hard-depend on com_android_launcher3_flags_lib and   -->
    <!-- platform_testing on launcher-aosp-tapl. Launcher3/Launcher3Quick-  -->
    <!-- Step/WallpaperPicker2 APKs are filtered out of PRODUCT_PACKAGES    -->
    <!-- by config/debloat.mk - source present, payload never ships.        -->
    <remove-project name="platform/packages/apps/ThemePicker" />
    <remove-project name="platform/packages/apps/WallpaperPicker2" />

    <!-- ==== Remaining stock/utility bloat ================================ -->
    <!-- Each drops a named user feature - deliberately stripped:
         DeskClock (no suite clock app yet), Stk (SIM toolkit UI),
         EmergencyInfo, SafetyRegulatoryInfo (regulatory-marks screen -
         check regional compliance needs), SettingsIntelligence (settings
         suggestions), PrivateSpace, QuickAccessWallet (Google Pay slot),
         ImsServiceEntitlement.
         Messaging KEPT - it is the default SMS app.                       -->
    <remove-project name="platform/packages/apps/DeskClock" />
    <remove-project name="platform/packages/apps/Stk" />
    <remove-project name="platform/packages/apps/EmergencyInfo" />
    <remove-project name="platform/packages/apps/SafetyRegulatoryInfo" />
    <remove-project name="platform/packages/apps/SettingsIntelligence" />
    <remove-project name="platform/packages/apps/PrivateSpace" />
    <remove-project name="platform/packages/apps/QuickAccessWallet" />
    <remove-project name="platform/packages/apps/ImsServiceEntitlement" />

    <!-- ==== Dev / demo / test leftovers ================================== -->
    <remove-project name="platform/packages/apps/DevCamera" />
    <remove-project name="platform/packages/apps/DeviceDiagnostics" />
    <remove-project name="platform/packages/apps/EyeDropper" />
    <remove-project name="platform/packages/apps/Multiuser" />
    <remove-project name="platform/packages/apps/OnDeviceAppPrediction" />
    <remove-project name="platform/packages/apps/Protips" />
    <remove-project name="platform/packages/apps/SampleLocationAttribution" />
    <remove-project name="platform/packages/apps/SpareParts" />
    <remove-project name="platform/packages/apps/Tag" />
    <remove-project name="platform/packages/apps/Test/connectivity" />
    <!-- KEPT (source): packages/apps/Traceur - SystemUI-core links        -->
    <!-- TraceurCommon + Traceur-res. The Traceur APK stays filtered out   -->
    <!-- of PRODUCT_PACKAGES by config/debloat.mk.                         -->
    <remove-project name="platform/packages/apps/UniversalMediaPlayer" />
    <remove-project name="platform/developers/build" />
    <remove-project name="platform/developers/samples/android" />
    <!-- KEPT: platform/development defines platform_tools_version, a hard -->
    <!-- dep of libfastboot / libadb (real host tools that ship).          -->
    <remove-project name="device/sample" />
    <remove-project name="trusty/app/sample" />

    <!-- ==== Android TV form factor ======================================= -->
    <remove-project name="platform/packages/apps/TV" />
    <remove-project name="platform/packages/apps/TvSettings" />
    <remove-project name="platform/packages/apps/TvSystemUI" />
    <remove-project name="platform/packages/apps/TvFeedbackConsent" />
    <remove-project name="device/google/atv" />

    <!-- ==== Automotive (AAOS) form factor ================================ -->
    <!-- Car/systemlibs is KEPT - it provides car-ui-lib, used by           -->
    <!-- PermissionController and frameworks/opt/car setupwizard.           -->
    <remove-project name="platform/packages/apps/Car/CalendarPrebuilt" />
    <remove-project name="platform/packages/apps/Car/Cluster" />
    <remove-project name="platform/packages/apps/Car/DataSubscriptionReference" />
    <remove-project name="platform/packages/apps/Car/DebuggingRestrictionController" />
    <remove-project name="platform/packages/apps/Car/DialerPrebuilt" />
    <remove-project name="platform/packages/apps/Car/DriverUIPrebuilt" />
    <remove-project name="platform/packages/apps/Car/LatinIME" />
    <remove-project name="platform/packages/apps/Car/Launcher" />
    <remove-project name="platform/packages/apps/Car/LinkViewer" />
    <remove-project name="platform/packages/apps/Car/LocalMediaPlayer" />
    <remove-project name="platform/packages/apps/Car/MediaPrebuilt" />
    <remove-project name="platform/packages/apps/Car/MessengerPrebuilt" />
    <remove-project name="platform/packages/apps/Car/Notification" />
    <remove-project name="platform/packages/apps/Car/Provision" />
    <remove-project name="platform/packages/apps/Car/RadioPrebuilt" />
    <remove-project name="platform/packages/apps/Car/References" />
    <remove-project name="platform/packages/apps/Car/RotaryController" />
    <remove-project name="platform/packages/apps/Car/RotaryImePrebuilt" />
    <remove-project name="platform/packages/apps/Car/Settings" />
    <remove-project name="platform/packages/apps/Car/SettingsIntelligence" />
    <!-- KEPT: Car/SystemUI defines CarSystemUI-core + systemui_car aconfig -->
    <!-- flags, required by Car/systemlibs and services/Car distant display.-->
    <remove-project name="platform/packages/apps/Car/SystemUpdater" />
    <remove-project name="platform/packages/apps/Car/Templates" />
    <remove-project name="platform/packages/apps/Car/VoiceControl" />
    <remove-project name="device/google_car" />
    <remove-project name="device/generic/car" />

    <!-- ==== Virtual-device stack, x86-64/cuttlefish only (~2 GB) ========= -->
    <!-- aarch64 emulator is KEPT (goldfish + generic/arm64 + qemu-kernel + -->
    <!-- android-emulator + aemu + gfxstream stay synced). The cuttlefish   -->
    <!-- source repo is KEPT too - platform_testing's automotive proxy      -->
    <!-- needs its cuttlefish_base module. Only the GB-heavy prebuilt VM    -->
    <!-- images, the vmm, and trout/contexthub/etm extras go.               -->
    <remove-project name="device/google/cuttlefish_prebuilts" />
    <remove-project name="device/google/cuttlefish_vmm" />
    <remove-project name="device/google/trout" />
    <remove-project name="device/google/contexthub" />
    <remove-project name="device/google/common/etm" />

    <!-- ==== Kernel prebuilt images (~2 GB) =============================== -->
    <!-- GKI/prebuilt kernel images. arm64 (6.6, 6.12, mainline) is KEPT    -->
    <!-- for the aarch64 emulator; x86-64 and all virtual-device module     -->
    <!-- packs go (EclipseX device trees carry their own kernels).          -->
    <remove-project name="kernel/prebuilts/6.1/arm64" />
    <remove-project name="kernel/prebuilts/6.1/x86-64" />
    <remove-project name="kernel/prebuilts/6.6/x86-64" />
    <remove-project name="kernel/prebuilts/6.12/x86-64" />
    <remove-project name="kernel/prebuilts/mainline/x86-64" />
    <remove-project name="kernel/prebuilts/common-modules/trusty/6.6/arm64" />
    <remove-project name="kernel/prebuilts/common-modules/trusty/6.12/arm64" />
    <remove-project name="kernel/prebuilts/common-modules/virtual-device/6.1/arm64" />
    <remove-project name="kernel/prebuilts/common-modules/virtual-device/6.1/x86-64" />
    <remove-project name="kernel/prebuilts/common-modules/virtual-device/6.6/arm64" />
    <remove-project name="kernel/prebuilts/common-modules/virtual-device/6.6/x86-64" />
    <remove-project name="kernel/prebuilts/common-modules/virtual-device/6.12/arm64" />
    <remove-project name="kernel/prebuilts/common-modules/virtual-device/6.12/x86-64" />
    <remove-project name="kernel/prebuilts/common-modules/virtual-device/mainline/arm64" />
    <remove-project name="kernel/prebuilts/common-modules/virtual-device/mainline/x86-64" />
    <remove-project name="kernel/tests" />
    <!-- kernel/configs KEPT - provides kernel-config-soong-rules used by
         VINTF compatibility-matrix generation. -->

    <!-- ==== CTS / VTS / Tradefed test infrastructure (~4 GB) ============= -->
    <!-- Certification test suites - not part of the ROM, not needed to     -->
    <!-- build or run it. Re-add temporarily if you ever certify a device.  -->
    <!-- KEPT: cts, csuite, mts, vts, suite_harness, tradefederation core - -->
    <!-- they register the cts_defaults / mts-* / csuite_test / vts_* /     -->
    <!-- suite_harness / tradefed_* Soong modules that Android.bp files     -->
    <!-- across frameworks/base, art, packages/modules, hardware/interfaces -->
    <!-- and platform_testing reference. Removing them breaks every build   -->
    <!-- at blueprint analysis. (cts+test repos are ~4 GB - NOT optional.)  -->
    <remove-project name="platform/test/dittosuite" />
    <remove-project name="platform/test/graphics" />
    <remove-project name="platform/test/mlts/benchmark" />
    <remove-project name="platform/test/mlts/models" />
    <remove-project name="platform/test/cts-root" />
    <!-- KEPT: vts-testcase/hal defines libvts_vintf_test_common and       -->
    <!-- vts-testcase/vndk defines vts_vndk_utils - hard deps of           -->
    <!-- libassemblevintf (system/libvintf) and test/vts modules which are -->
    <!-- real build-time host tools, not tests. Removing breaks builds.    -->
    <remove-project name="platform/test/vts-testcase/kernel" />
    <remove-project name="platform/test/vts-testcase/nbu" />
    <remove-project name="platform/test/vts-testcase/performance" />
    <remove-project name="platform/test/vts-testcase/security" />
    <remove-project name="platform/test/catbox" />
    <remove-project name="platform/tools/tradefederation/contrib" />
    <remove-project name="platform/tools/tradefederation/prebuilts" />
    <remove-project name="platform/prebuilts/asuite" />

    <!-- ==== VNDK snapshots - ALL KEPT ==================================== -->
    <!-- packages/modules/vndk/apex builds com.android.vndk.v31-v34 on      -->
    <!-- every build; each version sources its vndk*/llndk library lists    -->
    <!-- from the matching prebuilts/vndk/v* repo. All are build deps.      -->

    <!-- ==== NDK prebuilts (~1-2 GB) - KEPT =============================== -->
    <!-- prebuilts/ndk defines ndk_system, a hard dep of libprotobuf-c-nano -->
    <!-- (external/nanopb-c) and other NDK-variant libs. Removing breaks    -->
    <!-- every build at blueprint analysis.                                 -->
    <!-- prebuilts/sdk KEPT - its prebuilt_apis modules generate the        -->
    <!-- *.api.<scope>.<ver> / *.api.combined.* modules that sdk_library    -->
    <!-- consumers depend on at blueprint analysis.                         -->

    <!-- ==== Dev-board / generic reference targets ======================== -->
    <!-- Amlogic/Linaro dev boards + generic aosp_* products. Kept:         -->
    <!-- device/generic/common + goldfish + trusty (android-x86 base for    -->
    <!-- uefix64pc) and device/generic/arm64 (aarch64 emulator target).     -->
    <remove-project name="device/amlogic/yukawa" />
    <remove-project name="device/amlogic/yukawa-kernel" />
    <remove-project name="device/linaro/dragonboard" />
    <remove-project name="device/linaro/dragonboard-kernel" />
    <remove-project name="device/linaro/hikey" />
    <remove-project name="device/linaro/hikey-kernel" />
    <remove-project name="device/generic/art" />
    <remove-project name="device/generic/armv7-a-neon" />
    <remove-project name="device/generic/x86" />
    <remove-project name="device/generic/x86_64" />

    <!-- ================================================================== -->
    <!-- KEPT ON PURPOSE (do not remove - API/compat surface):              -->
    <!--   external/chromium-webview + frameworks webview  WebView API      -->
    <!--   packages/apps/DocumentsUI                       SAF picker       -->
    <!--   KeyChain, CertInstaller                         credential APIs  -->
    <!--   ManagedProvisioning                             provisioning       -->
    <!--   CarrierConfig, CellBroadcastReceiver            carrier/reg.     -->
    <!--   Contacts, ContactsPicker, providers/*             PIM APIs       -->
    <!--   Dialer, Messaging, BasicSmsReceiver, PhoneCommon  telephony+SMS  -->
    <!--   device/generic/arm64, prebuilts/android-emulator|qemu-kernel,    -->
    <!--   hardware/google/aemu|gfxstream, kernel/prebuilts/*/arm64         -->
    <!--                                                     aarch64 emu    -->
    <!--   SecureElement, Settings, StorageManager, SystemUIGo              -->
    <!--   CaptivePortalLogin, Provision                     boot/setup     -->
    <!--   all packages/modules/* except the ads pair      API surface      -->
    <!--   prebuilts/module_sdk/* (rest)                   module SDKs      -->
    <!--   device/generic/common|goldfish|trusty           android-x86 base -->
    <!--   prebuilts/clang|rust|go|jdk|build-tools|misc|tools|r8|bazel etc. -->
    <!--                                                     toolchain      -->
    <!-- ================================================================== -->
</manifest>
