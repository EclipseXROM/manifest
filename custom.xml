<?xml version="1.0" encoding="UTF-8"?>
<manifest>
    <!-- Remotes -->
    <!-- Note: aosp remote is defined in aosp.xml -->
    <remote name="graphene" fetch="https://github.com/GrapheneOS/" />
    <remote name="evox" fetch="https://github.com/Evolution-X/" />
    <remote name="docker" fetch="https://github.com/" />
    <remote name="eclipsex" fetch="https://github.com/EclipseXROM/" />
    <remote name="divested" fetch="https://github.com/Divested-Mobile/" />
    <remote name="calyx" fetch="https://github.com/CalyxOS/" />

    <!-- Note: default is defined in aosp.xml -->

    <!-- EclipseXROM UEFI x64 device target -->
    <project name="device_uefix64pc"
             path="device/eclipsex/uefix64pc"
             remote="eclipsex"
             revision="main" />

    <!-- EclipseXROM device repositories -->
    <project name="device_huawei_angler"
             path="device/huawei/angler"
             remote="eclipsex"
             revision="lineage-17.1" />
    <project name="device_samsung_crownlte"
             path="device/samsung/crownlte"
             remote="eclipsex"
             revision="lineage-20" />
    <project name="device_samsung_starlte"
             path="device/samsung/starlte"
             remote="eclipsex"
             revision="lineage-20" />
    <project name="device_samsung_gracerlte"
             path="device/samsung/gracerlte"
             remote="eclipsex"
             revision="lineage-17.1" />

    <!-- EclipseXROM common - merged Manikineko userland: first-party app
         suite, EclipseX Home launcher + OOBE, signed app store, branding,
         debloat tooling. Ships the EclipseX product layer. -->
    <project name="common"
             path="vendor/eclipsex/common"
             remote="eclipsex"
             revision="main" />

    <!-- Magisk fork - parked as source only. NOT under external/: its
         native/src/Android.mk trips AOSP's androidmk denylist at every
         build. Magisk is not AOSP-buildable anyway (own NDK/Rust build). -->
    <project name="magisk"
             path="vendor/eclipsex/magisk"
             remote="eclipsex"
             revision="master" />
</manifest>
